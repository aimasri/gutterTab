cmake_minimum_required(VERSION 3.16)
project(TestSave)
find_package(Qt6 COMPONENTS Core Sql REQUIRED)
set(CMAKE_AUTOMOC ON)
add_executable(test_save test_save.cpp src/domain/TabController.cpp src/infrastructure/DatabaseManager.cpp src/infrastructure/ConfigManager.cpp)
target_link_libraries(test_save Qt6::Core Qt6::Sql)
